{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "exclude": ["src/**/*.test.ts"],
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../kernel" }, { "path": "../protocol" }]
}
