{
  "name": "popeye",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "tsc --build",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "lint": "biome check . --error-on-warnings",
    "prepare": "lefthook install",
    "release:check": "node scripts/release-packages.mjs check",
    "test": "vitest run",
    "typecheck": "tsc --build && tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.3",
    "lefthook": "2.1.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "version": "0.1.4"
}
